# Merge the declared spaces and pins into a Zen session (zen-sessions.jsonlz4).
# $declared is {spaces: [...], pins: [...]}, generated by nix. Undeclared
# spaces, pins and tabs are kept, and unknown fields on existing rows survive.
#
# `index` on a tab row is the session-history position of its current entry
# (1-based, so a pin with 18 entries has index 18), not a position in the
# strip. Tab order is the order of the array, so reordering never touches it.
#
# Essentials carry no zenWorkspace: Zen drops it when a tab becomes essential
# and shows essentials per container, so they are matched by userContextId.

def pinned: .pinned == true or .zenEssential == true;
def initUrl: ._zenPinnedInitialState.entry.url // ((.entries // []) | last | .url) // "";
def norm: rtrimstr("/");
def hostOf: (capture("^[a-z][a-z0-9+.-]*://(?<h>[^/?#]+)") | .h) // "";

# Does this tab row belong to the pin's section (its workspace, or for an
# essential its container)?
def inSection($p):
    if $p.essential then .zenEssential == true and .userContextId == $p.container
    else .zenWorkspace == $p.workspace and .zenEssential != true end;

# Unclaimed pinned tabs of the pin's section, as {key, value} entries of .tabs.
# Tabs that split views or folders point at by id are never candidates, since
# rewriting their zenSyncId would break that reference.
def candidates($p; $ids; $refs):
    [ to_entries[]
      | select((.value | pinned) and (.value | inSection($p))
               and ((.value.zenSyncId // "") as $s | ($ids | index($s)) == null)
               and ((.value.zenSyncId // "") as $s | ($refs | index($s)) == null)
               and ((.value.id // "") as $s | ($refs | index($s)) == null)) ];

# Rewrite the zenSyncId of one unclaimed tab per declared pin, in two passes
# (exact URL first, then a unique host match) so a loose host match can never
# steal a tab that another declared pin matches exactly.
def adopt($pins; $ids; $refs):
    reduce $pins[] as $p (.;
        if any(.tabs[]; .zenSyncId == $p.id) then .
        else (.tabs | candidates($p; $ids; $refs)
              | map(select((.value | initUrl | norm) == ($p.url | norm)))
              | .[0].key) as $k
            | if $k != null then .tabs[$k].zenSyncId = $p.id else . end
        end)
    | reduce $pins[] as $p (.;
        if any(.tabs[]; .zenSyncId == $p.id) then .
        else (.tabs | candidates($p; $ids; $refs)
              | map(select((.value | initUrl | hostOf) == ($p.url | hostOf)))) as $c
            | if ($c | length) == 1 then .tabs[$c[0].key].zenSyncId = $p.id else . end
        end);

# The initial state is what the "pin changed" badge compares against, so a
# pin that redirects within the declared host keeps the URL it was made with.
# nixUrl records the declared URL, so a later change to the declaration still
# reaches pins that were adopted by host.
def enforce($p):
    .pinned = true
    | .zenEssential = $p.essential
    | .zenWorkspace = (if $p.essential then null else $p.workspace end)
    | .userContextId = $p.container
    | .zenDefaultUserContextId = "true"
    | if (initUrl | hostOf) != ($p.url | hostOf)
         or (initUrl | norm) == ($p.url | norm)
         or (._zenPinnedInitialState.nixUrl != null and ._zenPinnedInitialState.nixUrl != $p.url)
      then ._zenPinnedInitialState.entry.url = $p.url
           | ._zenPinnedInitialState.entry.title //= ($p.url | hostOf)
      else . end
    | ._zenPinnedInitialState.nixUrl = $p.url
    | if $p.name != null then .zenStaticLabel = $p.name else . end;

def newRow($p):
    { pinned: true,
      hidden: false,
      zenWorkspace: (if $p.essential then null else $p.workspace end),
      zenSyncId: $p.id,
      zenEssential: $p.essential,
      zenDefaultUserContextId: "true",
      zenPinnedIcon: null,
      zenIsEmpty: false,
      zenHasStaticIcon: false,
      zenGlanceId: null,
      zenIsGlance: false,
      searchMode: null,
      userContextId: $p.container,
      attributes: {},
      index: 1,
      lastAccessed: 0,
      groupId: null,
      entries: [{ url: $p.url, title: ($p.url | hostOf), charset: "UTF-8", ID: 0, persist: true,
                  triggeringPrincipal_base64: "{\"3\":{}}" }],
      _zenPinnedInitialState: { entry: { url: $p.url, title: ($p.url | hostOf) }, nixUrl: $p.url }
    }
    | if $p.name != null then .zenStaticLabel = $p.name else . end;

# Declared pins first (declared order), then other pinned tabs, then the rest,
# written back into the slots the section's tabs already occupy so everything
# else stays exactly where it is. Tabs in a folder (groupId set) keep their
# slot too. Duplicate ids never drop a tab; if the count would change the
# array is returned as it was.
def order(section; $ids):
    . as $all
    | ($ids | reduce .[] as $i ([]; if index($i) == null then . + [$i] else . end)) as $uids
    | [ range(0; length) | select(($all[.] | section) and $all[.].groupId == null) ] as $slots
    | ($slots | map($all[.])) as $mine
    | ( ($uids | map(. as $i | $mine[] | select(.zenSyncId == $i)))
        + [ $mine[] | select((.zenSyncId as $s | $uids | index($s)) == null and .pinned == true) ]
        + [ $mine[] | select((.zenSyncId as $s | $uids | index($s)) == null and .pinned != true) ] ) as $sorted
    | if ($sorted | length) != ($slots | length) then $all
      else reduce range(0; $slots | length) as $n ($all; .[$slots[$n]] = $sorted[$n]) end;

$declared[0] as $d
| ($d.pins | map(.id)) as $ids
| (.spaces // []) as $es
| .spaces = (
    [ $d.spaces[] as $s
      | ($es | map(select(.uuid == $s.uuid)) | .[0]) as $e
      | ($e // { theme: { type: "gradient", gradientColors: [], opacity: 0.5, texture: 0 },
                 hasCollapsedPinnedTabs: false })
        * { uuid: $s.uuid, name: $s.name, icon: $s.icon,
            containerTabId: $s.container, position: $s.position } ]
    + [ $es[] | select(.uuid as $u | $d.spaces | map(.uuid) | index($u) | not) ])
| .tabs = (.tabs // [])
| ([ (.splitViewData // []), (.folders // []) | .. | strings ] | unique) as $refs
| adopt($d.pins; $ids; $refs)
| reduce $d.pins[] as $p (.;
    if any(.tabs[]; .zenSyncId == $p.id)
    then .tabs |= map(if .zenSyncId == $p.id then enforce($p) else . end)
    else .tabs += [newRow($p)]
    end)
| reduce ($d.pins | map({essential, section: (if .essential then (.container | tostring) else .workspace end)}) | unique[]) as $s (.;
    ([ $d.pins[] | select(.essential == $s.essential
                          and (if .essential then (.container | tostring) else .workspace end) == $s.section) ]) as $sp
    | .tabs |= order(if $s.essential
                     then (.zenEssential == true and .userContextId == $sp[0].container)
                     else (.zenWorkspace == $sp[0].workspace and .zenEssential != true) end;
                     [$sp[].id]))
