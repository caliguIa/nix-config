#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   =   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | GUI  | ALT  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&none       &none  &none  &none         &none      &none                                      &none          &none      &none          &none    &none     &none
&kp TAB     &kp Q  &kp W  &kp E         &kp R      &kp T                                      &kp Y          &kp U      &kp I          &kp O    &kp P     &kp BACKSPACE
&kp ESCAPE  &kp A  &kp S  &kp D         &kp F      &kp G                                      &kp H          &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z  &kp X  &kp C         &kp V      &kp B          &kp SPACE      &kp ENTER    &kp N          &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp RSHFT
                          &kp LEFT_ALT  &kp LCTRL  &kp LEFT_META  &lt 1 SPACE    &lt 2 ENTER  &kp RIGHT_GUI  &kp RCTRL  &kp RIGHT_ALT
            >;
        };

        brackets_numbers {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1   | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // | RC(1) | RC(2) |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !    |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |       |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans      &trans         &trans            &trans          &trans                &trans                       &trans        &trans                 &trans           &trans           &trans            &trans
&trans      &kp N1         &kp N2            &kp N3          &kp N4                &kp N5                       &kp NUMBER_6  &kp N7                 &kp N8           &kp N9           &kp N0            &trans
&caps_word  &kp LESS_THAN  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp EQUAL                    &kp EQUAL     &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RBKT         &kp GREATER_THAN  &trans
&mo 3       &trans         &kp KP_MULTIPLY   &kp KP_MINUS    &kp KP_PLUS           &trans     &trans    &trans  &trans        &kp KP_PLUS            &kp KP_MINUS     &kp KP_MULTIPLY  &trans            &trans
                                             &trans          &trans                &trans     &trans    &trans  &trans        &trans                 &trans
            >;
        };

        symbols_funcs {
            bindings = <
&trans     &trans           &trans       &trans         &trans      &trans                                  &trans     &trans                    &trans                &trans          &trans             &trans
&trans     &kp F1           &kp F2       &kp F3         &kp F4      &kp F5                                  &kp F6     &kp F7                    &kp F8                &kp F9          &kp F10            &trans
&kp POUND  &kp EXCLAMATION  &kp AT_SIGN  &kp BACKSLASH  &kp DOLLAR  &kp PERCENT                             &kp CARET  &kp AMPERSAND             &kp ASTERISK          &kp UNDERSCORE  &kp DOUBLE_QUOTES  &kp KP_PLUS
&trans     &trans           &trans       &kp GRAVE      &kp PIPE    &trans       &trans    &kp PRINTSCREEN  &trans     &kp LS(NON_US_BACKSLASH)  &kp NON_US_BACKSLASH  &kp MINUS       &trans             &trans
                                         &trans         &trans      &trans       &trans    &trans           &trans     &trans                    &trans
            >;
        };

        meta {
            bindings = <
&ext_power EP_ON  &ext_power EP_OFF  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1                        &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans             &trans  &trans  &trans        &trans                              &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans             &trans  &trans  &trans        &trans                              &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans             &trans  &trans  &trans        &trans        &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                             &trans  &trans        &trans        &trans        &trans  &trans  &trans  &trans
            >;
        };
    };
};
