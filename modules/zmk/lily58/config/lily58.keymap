#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NUM  1
#define SYM  2
#define META 3

/* Super+hjkl sends arrows (Super is dropped), as keyd does on the laptop. */
#define GUI_ARROW(name, key, arrow) \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <&kp key>, <&kp arrow>; \
        mods = <(MOD_LGUI|MOD_RGUI)>; \
    };

/ {
    behaviors {
        GUI_ARROW(gui_h, H, LEFT)
        GUI_ARROW(gui_j, J, DOWN)
        GUI_ARROW(gui_k, K, UP)
        GUI_ARROW(gui_l, L, RIGHT)
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&none      &none  &none  &none     &none      &none                                    &none     &none      &none      &none     &none     &none
&kp TAB    &kp Q  &kp W  &kp E     &kp R      &kp T                                    &kp Y     &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp ESC    &kp A  &kp S  &kp D     &kp F      &kp G                                    &gui_h    &gui_j     &gui_k     &gui_l    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V      &kp B      &kp SPACE      &kp ENTER      &kp N     &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                         &kp LALT  &kp LCTRL  &kp LGUI   &lt NUM SPACE  &lt SYM ENTER  &kp RGUI  &kp RCTRL  &kp RALT
            >;
        };

        brackets_numbers {
            display-name = "Numbers";
            bindings = <
&trans      &trans  &trans           &trans          &trans       &trans                    &trans     &trans       &trans           &trans           &trans  &trans
&trans      &kp N1  &kp N2           &kp N3          &kp N4       &kp N5                    &kp N6     &kp N7       &kp N8           &kp N9           &kp N0  &trans
&caps_word  &kp LT  &kp LBKT         &kp LBRC        &kp LPAR     &kp EQUAL                 &kp EQUAL  &kp RPAR     &kp RBRC         &kp RBKT         &kp GT  &trans
&mo META    &trans  &kp KP_MULTIPLY  &kp KP_MINUS    &kp KP_PLUS  &trans     &trans  &trans  &trans     &kp KP_PLUS  &kp KP_MINUS     &kp KP_MULTIPLY  &trans  &trans
                                     &trans          &trans       &trans     &trans  &trans  &trans     &trans       &trans
            >;
        };

        symbols_funcs {
            display-name = "Symbols";
            bindings = <
&trans     &trans    &trans  &trans     &trans     &trans                          &trans     &trans          &trans     &trans     &trans   &trans
&trans     &kp F1    &kp F2  &kp F3     &kp F4     &kp F5                          &kp F6     &kp F7          &kp F8     &kp F9     &kp F10  &trans
&kp TILDE  &kp EXCL  &kp DQT  &kp POUND  &kp DLLR   &kp PRCNT                       &kp CARET  &kp AMPS  &kp STAR  &kp UNDER  &kp AT  &kp KP_PLUS
&trans     &trans    &trans   &kp GRAVE  &kp TILDE  &trans     &trans  &kp PSCRN    &trans     &kp PIPE  &kp BSLH  &kp MINUS  &trans  &trans
                             &trans     &trans     &trans     &trans  &trans       &trans     &trans          &trans
            >;
        };

        meta {
            display-name = "Meta";
            bindings = <
&bootloader  &sys_reset  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1                       &trans  &trans  &trans  &trans  &sys_reset  &bootloader
&trans       &trans      &trans  &trans  &trans        &trans                             &trans  &trans  &trans  &trans  &trans      &trans
&trans       &trans      &trans  &trans  &trans        &trans                             &trans  &trans  &trans  &trans  &trans      &trans
&trans       &trans      &trans  &trans  &trans        &trans        &bt BT_CLR  &trans   &trans  &trans  &trans  &trans  &trans      &trans
                                 &trans  &trans        &trans        &trans      &trans   &trans  &trans  &trans
            >;
        };
    };
};
